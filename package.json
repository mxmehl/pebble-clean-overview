{
  "name": "clean-overview",
  "author": "Max Mehl",
  "version": "1.2.0",
  "description": "A clean, minimal digital watchface with health stats at a glance. Large time display, configurable seconds (always/on shake), Bluetooth and quiet time indicators, heart rate, steps, calories, and battery. Dark/light mode, localized date format.",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "homepage": "https://github.com/mxmehl/pebble-clean-overview",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxmehl/pebble-clean-overview.git"
  },
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Clean Overview",
    "uuid": "7b06429c-0f4a-4f2a-a937-bc10de373eae",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "projectType": "native",
    "capabilities": [
      "configurable",
      "health"
    ],
    "messageKeys": [
      "DARK_MODE",
      "SECONDS_MODE",
      "SHAKE_DURATION",
      "VIBRATE_ON_DISCONNECT",
      "SHOW_WEEK"
    ],
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "resources": {
      "media": [
        {
          "file": "images/menu-icon",
          "menuIcon": true,
          "name": "IMAGE_MENU_ICON",
          "targetPlatforms": null,
          "type": "png"
        }
      ]
    }
  }
}
